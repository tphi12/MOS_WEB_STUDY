<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  <Id>7192b75f-6ce0-4d93-a38d-91731c0a1c4f</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Wordie MOS Study</ProviderName>
  <DefaultLocale>vi-VN</DefaultLocale>
  <DisplayName DefaultValue="Wordie MOS Final Tests"/>
  <Description DefaultValue="Bài thi cuối khóa MOS Word được chấm trực tiếp bằng Office.js."/>
  <IconUrl DefaultValue="https://localhost:5173/wordie-icon.png"/>
  <SupportUrl DefaultValue="https://localhost:5173/"/>
  <AppDomains>
    <AppDomain>https://localhost:5173</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:5173/tests"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="WordApi"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Wordie.Group">
                <Label resid="Wordie.GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Wordie.Icon16"/>
                  <bt:Image size="32" resid="Wordie.Icon32"/>
                  <bt:Image size="80" resid="Wordie.Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="Wordie.ShowTaskpane">
                  <Label resid="Wordie.ButtonLabel"/>
                  <Supertip>
                    <Title resid="Wordie.ButtonLabel"/>
                    <Description resid="Wordie.ButtonDescription"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Wordie.Icon16"/>
                    <bt:Image size="32" resid="Wordie.Icon32"/>
                    <bt:Image size="80" resid="Wordie.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Office.AutoShowTaskpaneWithDocument</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Wordie.Icon16" DefaultValue="https://localhost:5173/wordie-icon.png"/>
        <bt:Image id="Wordie.Icon32" DefaultValue="https://localhost:5173/wordie-icon.png"/>
        <bt:Image id="Wordie.Icon80" DefaultValue="https://localhost:5173/wordie-icon.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:5173/tests"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Wordie.GroupLabel" DefaultValue="Wordie MOS"/>
        <bt:String id="Wordie.ButtonLabel" DefaultValue="Mở Wordie"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Wordie.ButtonDescription" DefaultValue="Mở Task Pane Wordie để nhận đề và nộp bài."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
