{
  "name": "mos-word-learning-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "office:validate": "office-addin-manifest validate wordie-office-addin.xml",
    "office:manifest:production": "node scripts/create-production-manifest.mjs",
    "office:start": "office-addin-debugging start wordie-office-addin.xml desktop --app word --no-debug --dev-server-port 5173",
    "office:stop": "office-addin-debugging stop wordie-office-addin.xml desktop"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^11.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "ckeditor5": "^48.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.1",
    "typescript": "^5.8.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "office-addin-debugging": "^6.1.1",
    "office-addin-dev-certs": "^2.0.9",
    "office-addin-manifest": "^2.1.5",
    "playwright": "^1.60.0"
  },
  "overrides": {
    "@microsoft/app-manifest": {
      "strip-bom": "3.0.0"
    }
  }
}
